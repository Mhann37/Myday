# Copy to .env.local for local development. On Vercel, set these in
# Project > Settings > Environment Variables instead.

# The passcode you type to open the app. Pick something long (a short phrase is great).
APP_PASSCODE=

# Optional extra secret used when signing the login cookie (any long random string).
AUTH_SECRET=

# Neon Postgres connection string. Vercel adds this for you when you connect a
# Neon database to the project. Leave empty locally to use a throwaway JSON file
# in .data/ instead.
DATABASE_URL=
